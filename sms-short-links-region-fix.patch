From 226d10aa3f0a983babd6c10efbbea99653a03a5c Mon Sep 17 00:00:00 2001
From: Cognava <dev@samuhia.co.ke>
Date: Tue, 13 Oct 2026 11:34:42 +0000
Subject: [PATCH] invoiceLink: deploy to europe-west1 (Hosting rewrites do not
 support africa-south1)

---
 firebase.json         | 2 +-
 whatsapp/src/index.ts | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git a/firebase.json b/firebase.json
index 2534dea..633e47c 100644
--- a/firebase.json
+++ b/firebase.json
@@ -29,7 +29,7 @@
           "source": "/i/**",
           "function": {
             "functionId": "invoiceLink",
-            "region": "africa-south1"
+            "region": "europe-west1"
           }
         },
         {
diff --git a/whatsapp/src/index.ts b/whatsapp/src/index.ts
index 602015c..70d891d 100644
--- a/whatsapp/src/index.ts
+++ b/whatsapp/src/index.ts
@@ -2645,7 +2645,8 @@ function isFlagsOnlySelfTrigger(before: any, after: any): boolean {
 export const invoiceLink = onRequest({
     timeoutSeconds: 15,
     memory: '256MiB',
-    region: 'africa-south1',
+    // Hosting rewrites cannot target africa-south1, so this one function lives in a supported region
+    region: 'europe-west1',
     invoker: 'public'
 }, async (req, res) => {
     res.set("X-Robots-Tag", "noindex, nofollow");
-- 
2.43.0

